@@ -57,6 +49,45 @@ QtObject {
         css += `@define-color sidebar_border_color @window_bg_color;\n`
         css += `@define-color sidebar_backdrop_color @window_bg_color;\n`
 
+        // With a translucent frosted-glass background, an accent-colored
+        // selection wash looks out of place. Replace it with a flat grey fill
+        // so selection reads via contrast rather than color.
+        const SELECTION_BG = "#2e2e2e"
+
+        // Thunar's file-view selection "pill" is NOT drawn from CSS -- Thunar
+        // paints it in C (thunar_util_clip_view_background) via a
+        // gtk_style_context_lookup_color() of these two names. The fill colour
+        // is the only themeable part; a border is impossible without patching
+        // Thunar itself.
+        css += `\n@define-color theme_selected_bg_color ${SELECTION_BG};\n`
+        css += `@define-color theme_unfocused_selected_bg_color ${SELECTION_BG};\n`
+
+        css += `\nplacessidebar row:selected, placessidebar row:selected:focus,\n`
+        css += `treeview.view:selected, treeview.view:selected:focus,\n`
+        css += `.view:selected, .view:selected:focus,\n`
+        css += `iconview:selected, iconview:selected:focus {\n`
+        css += `  background-color: ${SELECTION_BG};\n`
+        css += `  box-shadow: none;\n`
+        css += `}\n`
+
+        // Thunar ships internal CSS making .view:selected transparent so only
+        // the C-drawn pill shows. The rule above re-colours it, which switches
+        // exo's text-cell background back on and black-multiplies the icon
+        // tint -- so put Thunar's file view back to transparent. Other apps
+        // keep the grey selection above.
+        css += `\n.standard-view .view:selected,\n`
+        css += `.standard-view .view:selected:focus {\n`
+        css += `  background-color: transparent;\n`
+        css += `  box-shadow: none;\n`
+        css += `}\n`
+
+        // exo-icon-view always renders the label cell background; against a
+        // translucent view_bg_color that reads as a permanent dark box behind
+        // every filename.
+        css += `\n.standard-view .view.cell {\n`
+        css += `  background-color: transparent;\n`
+        css += `}\n`
+
