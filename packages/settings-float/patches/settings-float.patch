diff --git a/modules/widgets/config/SettingsWindow.qml b/modules/widgets/config/SettingsWindow.qml
index 67993a5f..fbf08c30 100644
--- a/modules/widgets/config/SettingsWindow.qml
+++ b/modules/widgets/config/SettingsWindow.qml
@@ -38,7 +38,52 @@ FloatingWindow {
         return null;
     }
 
+    // settings-float mod: float the window and centre it on its target screen
+    // at a size derived from that screen, through the same compositor
+    // abstraction the placement below already uses (axctl: Hyprland, Niri,
+    // Mango). Percentages and the on/off switch come from the mod's settings;
+    // the QML implicit size above is the floor so panels never get cramped,
+    // and 92% of the screen is the ceiling for small laptop displays.
+    property bool floatEnabled: true
+    property real floatWidthPercent: 41
+    property real floatHeightPercent: 66
+    readonly property string floatModId: "drpezzer.settings-float"
+
+    function loadFloatSettings() {
+        if (typeof ModsService === "undefined" || typeof ModsService.getSettings !== "function") return;
+        ModsService.getSettings(floatModId, (settings, error) => {
+            if (error || !settings) return;
+            const v = settings.values || {};
+            if (v.enabled !== undefined) floatEnabled = !!v.enabled;
+            const wp = Number(v.widthPercent), hp = Number(v.heightPercent);
+            if (!isNaN(wp) && wp > 0) floatWidthPercent = wp;
+            if (!isNaN(hp) && hp > 0) floatHeightPercent = hp;
+        });
+    }
+
+    function floatSize(screenPx, percent, minimum) {
+        const wanted = Math.max(screenPx * percent / 100, minimum);
+        return Math.round(Math.min(wanted, screenPx * 0.92));
+    }
+
+    function floatAndCenter(client) {
+        if (!floatEnabled || !client || !client.address) return;
+        const scr = settingsWindow.screen;
+        if (!scr || !scr.width || !scr.height) return;
+        const w = floatSize(scr.width, floatWidthPercent, settingsWindow.implicitWidth);
+        const h = floatSize(scr.height, floatHeightPercent, settingsWindow.implicitHeight);
+        const x = Math.round(scr.x + (scr.width - w) / 2);
+        const y = Math.round(scr.y + (scr.height - h) / 2);
+        const addr = client.address;
+        if (!client.floating) {
+            BackendService.notify("compositor.dispatch", { args: ["window", "toggle-floating", addr] });
+        }
+        BackendService.notify("compositor.dispatch", { args: ["window", "resize", String(w), String(h), addr] });
+        BackendService.notify("compositor.dispatch", { args: ["window", "move-pixel", String(x), String(y), addr] });
+    }
+
     function preparePlacement() {
+        loadFloatSettings();
         placementTimer.attempts = 0;
         placementTimer.restart();
     }
@@ -55,6 +100,7 @@ FloatingWindow {
                     AxctlService.dispatch(`movetoworkspacesilent ${targetWorkspace}, address:${client.address}`);
                 }
                 AxctlService.dispatch(`focuswindow address:${client.address}`);
+                floatAndCenter(client);
                 return true;
             }
         }
