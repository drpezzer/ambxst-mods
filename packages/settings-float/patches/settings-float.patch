diff --git a/modules/widgets/config/SettingsWindow.qml b/modules/widgets/config/SettingsWindow.qml
index 67993a5f..400eb167 100644
--- a/modules/widgets/config/SettingsWindow.qml
+++ b/modules/widgets/config/SettingsWindow.qml
@@ -38,6 +38,42 @@ FloatingWindow {
         return null;
     }
 
+    // settings-float mod. Until the window has been placed it declares a
+    // FIXED size (minimum == maximum), derived from the target screen, which is
+    // resolved before the backing window exists. Compositors treat a fixed-size
+    // toplevel as a dialog and float it at map time (Hyprland and Niri also
+    // centre it, keeping clear of bars), so it never tiles first and never
+    // reflows the workspace. Once the compositor reports the window, the
+    // constraints are released so it can be resized by hand.
+    //
+    // There is deliberately NO toggle-floating fallback through the compositor
+    // state: axctl reports a window that was floated at map as not floating
+    // (no floating-change event ever fires for it), so acting on that flag
+    // tiled the window it was meant to float. Values come from
+    // SettingsFloatService (loaded at shell start), floors at the implicit size
+    // above, ceilings at 92% of the screen.
+    property bool floatLocked: SettingsFloatService.enabled
+
+    function floatSize(screenPx, percent, minimum) {
+        const wanted = Math.max(screenPx * percent / 100, minimum);
+        return Math.round(Math.min(wanted, screenPx * 0.92));
+    }
+
+    readonly property int floatW: screen ? floatSize(screen.width, SettingsFloatService.widthPercent, implicitWidth) : implicitWidth
+    readonly property int floatH: screen ? floatSize(screen.height, SettingsFloatService.heightPercent, implicitHeight) : implicitHeight
+
+    minimumSize: floatLocked ? Qt.size(floatW, floatH) : Qt.size(0, 0)
+    maximumSize: floatLocked ? Qt.size(floatW, floatH) : Qt.size(16777215, 16777215)
+
+    // Release the fixed-size hint a moment after the compositor has reported
+    // the window; a floating window keeps floating afterwards.
+    Timer {
+        id: releaseTimer
+        interval: 400
+        repeat: false
+        onTriggered: settingsWindow.floatLocked = false
+    }
+
     function preparePlacement() {
         placementTimer.attempts = 0;
         placementTimer.restart();
@@ -55,6 +91,7 @@ FloatingWindow {
                     AxctlService.dispatch(`movetoworkspacesilent ${targetWorkspace}, address:${client.address}`);
                 }
                 AxctlService.dispatch(`focuswindow address:${client.address}`);
+                releaseTimer.restart();
                 return true;
             }
         }
