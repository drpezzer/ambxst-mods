#!/usr/bin/env python3
"""Ambxst Skwd-wall Vulkan Transition Renderer Wrapper

Redirects images to pre-cached resolution-optimized JPEGs, fixes Wayland layer ordering,
and sets Vulkan environment flags to ensure instant initialization and zero stutter.
"""
import sys
import os
import hashlib
import subprocess
import shutil

HOME = os.path.expanduser("~")
BASE_CACHE_DIR = os.path.join(HOME, ".cache/skwd-wall-opt")
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"}

os.environ["SKWD_VK_LAYER"] = "bottom"
os.environ["SKWD_VK_DEVICE"] = "0"


def find_real_binary():
    # 1. Explicit env override
    if os.environ.get("SKWD_REAL_VK"):
        return os.environ["SKWD_REAL_VK"]
    # 2. Local Ambxst skwd-wall installation
    local_bin = os.path.join(HOME, ".local/share/ambxst/skwd-wall/current/bin/skwd-wall-vk")
    if os.path.isfile(local_bin) and os.access(local_bin, os.X_OK):
        return local_bin
    # 3. System install
    for p in ["/usr/bin/skwd-wall-vk", "/usr/local/bin/skwd-wall-vk"]:
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    # 4. PATH lookup excluding this wrapper
    this_path = os.path.realpath(__file__)
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "skwd-wall-vk")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            if os.path.realpath(candidate) != this_path:
                return candidate
    return "/usr/bin/skwd-wall-vk"


def get_opt_path(src):
    try:
        abs_p = os.path.abspath(src)
        ext = os.path.splitext(abs_p)[1].lower()
        if ext in IMAGE_EXTS:
            h = hashlib.sha256(abs_p.encode()).hexdigest()[:16]
            base = os.path.splitext(os.path.basename(abs_p))[0]
            # Match screen resolution directory if present
            if os.path.isdir(BASE_CACHE_DIR):
                for res_dir in os.listdir(BASE_CACHE_DIR):
                    cand = os.path.join(BASE_CACHE_DIR, res_dir, f"{h}_{base}.jpg")
                    if os.path.exists(cand):
                        return cand
            # Asynchronously pre-cache for future transitions
            precache_script = os.path.join(os.path.dirname(__file__), "skwd_precache.py")
            if os.path.isfile(precache_script):
                subprocess.Popen(
                    [sys.executable, precache_script, "--get", abs_p],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
    except Exception:
        pass
    return src


def main():
    args = sys.argv[1:]
    new_args = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--layer" and i + 1 < len(args):
            new_args.extend(["--layer", "bottom"])
            i += 2
        elif arg == "--transition-from" and i + 1 < len(args):
            from_file = get_opt_path(args[i + 1])
            new_args.extend(["--transition-from", from_file])
            i += 2
        else:
            if not arg.startswith("-") and os.path.isfile(arg):
                new_args.append(get_opt_path(arg))
            else:
                new_args.append(arg)
            i += 1

    if "--layer" not in new_args:
        new_args.extend(["--layer", "bottom"])

    real_bin = find_real_binary()
    os.execv(real_bin, [real_bin] + new_args)


if __name__ == "__main__":
    main()
