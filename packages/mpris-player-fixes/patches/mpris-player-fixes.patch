-        if (StateService.initialized && !root._restored) {
-            root._restored = true;
+        function onStateLoaded() {
             root.cachedDbusName = StateService.get("lastPlayerDbusName", "");
             root.loadLastPlayer();
         }
     }
 
     // --- Functions ---
+    // Firefox/Zen clears mpris:artUrl on every metadata change and only republishes it once the
+    // artwork has finished decoding, so YouTube tabs routinely sit with no art at all. The watch
+    // URL in xesam:url survives, so fall back to deriving the video thumbnail from it.
+    function artUrlFor(player) {
+        if (!player)
+            return "";
+
+        const art = player.trackArtUrl ?? "";
+        if (art !== "")
+            return art;
+
+        // mqdefault is the only 16:9 variant YouTube generates for every video. default,
+        // hqdefault and sddefault are 4:3 with letterbox bars baked into the image, which
+        // show up as black bands once the art is cropped into the cover disc, and
+        // hq720/maxresdefault 404 on anything that was never published above 480p.
+        // 320x180 is still oversampled for the 128px disc at scale 1.
+        const videoId = root.youtubeIdFor(player.metadata?.["xesam:url"] ?? "");
+        return videoId ? `https://i.ytimg.com/vi/${videoId}/mqdefault.jpg` : "";
+    }
+
+    function youtubeIdFor(url) {
+        if (!url)
+            return "";
+
+        // youtube.com/watch?v=ID and music.youtube.com/watch?v=ID
+        let match = url.match(/[?&]v=([\w-]{11})(?:[^\w-]|$)/);
+        // youtu.be/ID
+        if (!match)
+            match = url.match(/youtu\.be\/([\w-]{11})(?:[^\w-]|$)/);
+        // youtube.com/{shorts,embed,live}/ID
+        if (!match)
+            match = url.match(/youtube\.com\/(?:shorts|embed|live)\/([\w-]{11})(?:[^\w-]|$)/);
+
+        return match ? match[1] : "";
+    }
+
     function loadLastPlayer() {
         if (!root.cachedDbusName) {
             root.isInitializing = false;
