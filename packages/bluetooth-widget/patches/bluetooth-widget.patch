diff --git a/modules/theme/Icons.qml b/modules/theme/Icons.qml
index 3333506c..362151ca 100644
--- a/modules/theme/Icons.qml
+++ b/modules/theme/Icons.qml
@@ -266,4 +266,43 @@ QtObject {
     readonly property string thermometer: temperature
     readonly property string windowsLogo: terminalWindow
     readonly property string frameCorners: crop
+
+    // Maps BlueZ's Icon property (freedesktop icon names like "audio-headset")
+    // onto the icon font. Shared so the bar's Bluetooth widgets can't drift apart
+    // on what a keyboard or a gamepad looks like.
+    function bluetoothDeviceIcon(bluezIcon: string): string {
+        const icon = bluezIcon ?? "";
+        if (icon.includes("audio-headset") || icon.includes("headphone"))
+            return headphones;
+        if (icon.includes("input-keyboard"))
+            return keyboard;
+        if (icon.includes("input-mouse"))
+            return mouse;
+        if (icon.includes("phone"))
+            return phone;
+        if (icon.includes("watch"))
+            return watch;
+        if (icon.includes("input-gaming") || icon.includes("gamepad"))
+            return gamepad;
+        if (icon.includes("printer"))
+            return printer;
+        if (icon.includes("camera"))
+            return camera;
+        if (icon.includes("audio-speakers") || icon.includes("speaker"))
+            return speaker;
+        return bluetooth;
+    }
+
+    // Battery glyph for a whole-percent level.
+    function batteryLevelIcon(percent: int): string {
+        if (percent > 80)
+            return batteryFull;
+        if (percent > 60)
+            return batteryHigh;
+        if (percent > 40)
+            return batteryMedium;
+        if (percent > 20)
+            return batteryLow;
+        return batteryEmpty;
+    }
 }
