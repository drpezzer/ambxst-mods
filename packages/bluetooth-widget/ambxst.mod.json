{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "drpezzer.bluetooth-widget",
  "name": "Bluetooth widget",
  "version": "1.0.0",
  "description": "A Bluetooth indicator in the bar with a frame-attached flyout: power toggle, scanning, connect/disconnect/pair/trust/forget per device, plus a battery readout for connected devices. Hides the tray icon duty from blueman.",
  "license": "MIT",
  "author": "drpezzer",
  "authorUrl": "https://github.com/drpezzer",
  "homepage": "https://github.com/drpezzer/ambxst-mods",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0",
    "testedBaseCommits": [
      "6f9e93cb81767ff14c4867c349fc176d8d9e6697"
    ]
  },
  "dependencies": [
    "drpezzer.bar-popouts"
  ],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Controls Bluetooth adapters and devices through Quickshell.Bluetooth (BlueZ)"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothBatteryIndicator.qml",
      "target": "modules/bar/BluetoothBatteryIndicator.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothDeviceRow.qml",
      "target": "modules/bar/BluetoothDeviceRow.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothFlyout.qml",
      "target": "modules/bar/BluetoothFlyout.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothIndicator.qml",
      "target": "modules/bar/BluetoothIndicator.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/services/BluetoothBattery.qml",
      "target": "modules/services/BluetoothBattery.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/services/BluetoothControl.qml",
      "target": "modules/services/BluetoothControl.qml"
    },
    {
      "type": "patch",
      "source": "patches/bluetooth-widget.patch"
    }
  ]
}
