diff --git a/modules/services/GlobalShortcuts.qml b/modules/services/GlobalShortcuts.qml
index b1aa3be..31db127 100644
--- a/modules/services/GlobalShortcuts.qml
+++ b/modules/services/GlobalShortcuts.qml
@@ -51,6 +51,15 @@ QtObject {
             case "dashboard-widgets": toggleDashboardTab(0); break;
             case "dashboard-wallpapers": toggleDashboardTab(1); break;
             case "dashboard-kanban": toggleDashboardTab(2); break;
+            case "audio": // audio-routing: the tab's index is taken when a Dashboard completes;
+            case "dashboard-audio": // before that (cold shell) open the notch and let it land there
+                if (AudioRouting.dashboardTab >= 0) {
+                    toggleDashboardTab(AudioRouting.dashboardTab);
+                } else {
+                    AudioRouting.openPending = true;
+                    if (Visibilities.currentActiveModule !== "dashboard") Visibilities.setActiveModule("dashboard");
+                }
+                break;
             case "dashboard-assistant": toggleAssistant(); break;
             case "dashboard-controls": toggleSettings(); break;
 
diff --git a/modules/widgets/dashboard/Dashboard.qml b/modules/widgets/dashboard/Dashboard.qml
index 6b60935..708a2b8 100644
--- a/modules/widgets/dashboard/Dashboard.qml
+++ b/modules/widgets/dashboard/Dashboard.qml
@@ -11,6 +11,7 @@ import qs.modules.widgets.dashboard.widgets
 import qs.modules.widgets.dashboard.controls
 import qs.modules.widgets.dashboard.wallpapers
 import qs.modules.widgets.dashboard.metrics
+import qs.modules.widgets.dashboard.audio // audio-routing
 import qs.config
 
 NotchAnimationBehavior {
@@ -28,6 +29,32 @@ NotchAnimationBehavior {
     readonly property int tabSpacing: 8
 
     readonly property int tabWidth: 48
+
+    // audio-routing: adds its tab after whatever tabs are there when this
+    // Dashboard completes -- the built-in ones and any another mod added the
+    // same way before it -- so its index is taken, not claimed. The tab list
+    // and count are readonly, so the list is grown in place and its change
+    // signal raised by hand; every binding on it (count, the tab strip) follows.
+    // The highlight's position bindings are replaced because the stock
+    // getYForIndex parks anything past the third tab on the controls button.
+    // This runs before the Dashboard's own Component.onCompleted, so a pending
+    // `ambxst run audio` (sent before any Dashboard existed) lands on the tab.
+    QtObject {
+        Component.onCompleted: {
+            const index = root.tabModel.length;
+            root.tabModel.push(Icons.speakerHigh);
+            root.tabModelChanged();
+            AudioRouting.dashboardTab = index;
+            console.log("audio-routing: dashboard tab index", index);
+            const yFor = idx => idx < root.tabCount ? idx * (tabHighlight.width + root.tabSpacing) : controlsButtonContainer.y;
+            tabHighlight.targetY1 = Qt.binding(() => yFor(tabHighlight.idx1));
+            tabHighlight.targetY2 = Qt.binding(() => yFor(tabHighlight.idx2));
+            if (AudioRouting.openPending) {
+                AudioRouting.openPending = false;
+                GlobalStates.dashboardCurrentTab = index;
+            }
+        }
+    }
     readonly property real nonAnimWidth: (state.currentTab === 0 ? 600 : 400) + tabWidth + 16 // unified launcher tab is wider
 
     implicitWidth: nonAnimWidth
@@ -461,6 +488,14 @@ NotchAnimationBehavior {
                     sourceComponent: metricsComponent
                     z: visible ? 1 : 0
                 }
+
+                // audio-routing: its tab, at the index taken above (-1 until then,
+                // which matches no tab). Nothing here needs the focus helper below.
+                TabLoader {
+                    property int index: AudioRouting.dashboardTab
+                    sourceComponent: audioComponent
+                    z: visible ? 1 : 0
+                }
                 
                 // Helper to access current item for focus
                 property var currentItem: {
@@ -593,4 +628,10 @@ NotchAnimationBehavior {
         id: wallpapersComponent
         WallpapersTab {}
     }
+
+    // audio-routing
+    Component {
+        id: audioComponent
+        AudioTab {}
+    }
 }
