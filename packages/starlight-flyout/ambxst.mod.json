{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "drpezzer.starlight-flyout",
  "name": "Starlight render-queue flyout",
  "version": "1.0.0",
  "description": "Hover the top-right corner for a frame-merged panel showing the Topaz Starlight render queue driven by ~/.local/bin/topaz-starlight; only appears while a queue exists on disk.",
  "license": "MIT",
  "author": "drpezzer",
  "authorUrl": "https://github.com/drpezzer",
  "homepage": "https://github.com/drpezzer/ambxst-mods",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0",
    "testedBaseCommits": [
      "6f9e93cb81767ff14c4867c349fc176d8d9e6697"
    ]
  },
  "dependencies": [],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Reads ~/.local/state/topaz-starlight and runs ~/.local/bin/topaz-starlight-ctl"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/shell/StarlightFlyout.qml",
      "target": "modules/shell/StarlightFlyout.qml"
    },
    {
      "type": "patch",
      "source": "patches/starlight-flyout.patch"
    }
  ]
}
