{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "drpezzer.bar-glance",
  "name": "Bar at a Glance",
  "version": "1.0.0",
  "description": "More of your system readable straight from the bar. With contain-bar on, the clock, controls, battery/power-profile and layout popouts grow out of the frame instead of floating as pills. A Bluetooth indicator gets a frame-attached flyout with power, scanning, connect/pair/trust/forget per device, and a battery readout for connected devices. The weather glyph switches to moon and night variants after sunset.",
  "license": "MIT",
  "author": "drpezzer",
  "authorUrl": "https://github.com/drpezzer",
  "homepage": "https://github.com/drpezzer/ambxst-mods",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0",
    "testedBaseCommits": [
      "6f9e93cb81767ff14c4867c349fc176d8d9e6697"
    ]
  },
  "dependencies": [],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Controls Bluetooth adapters and devices through Quickshell.Bluetooth (BlueZ)",
    "Reads sunrise and sunset from the weather service to pick day or night glyphs"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothBatteryIndicator.qml",
      "target": "modules/bar/BluetoothBatteryIndicator.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothDeviceRow.qml",
      "target": "modules/bar/BluetoothDeviceRow.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothFlyout.qml",
      "target": "modules/bar/BluetoothFlyout.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/bar/BluetoothIndicator.qml",
      "target": "modules/bar/BluetoothIndicator.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/components/BarPopout.qml",
      "target": "modules/components/BarPopout.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/services/BluetoothBattery.qml",
      "target": "modules/services/BluetoothBattery.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/services/BluetoothControl.qml",
      "target": "modules/services/BluetoothControl.qml"
    },
    {
      "type": "overlay",
      "source": "payload/modules/shell/BarFlyout.qml",
      "target": "modules/shell/BarFlyout.qml"
    },
    {
      "type": "patch",
      "source": "patches/bar-glance.patch"
    }
  ]
}
