diff --git a/shell.qml b/shell.qml
index 888996d3..cdb3327c 100644
--- a/shell.qml
+++ b/shell.qml
@@ -2,6 +2,12 @@
 //@ pragma ShellId ambxst
 //@ pragma DataDir $BASE/ambxst
 //@ pragma StateDir $BASE/ambxst
+// Qt Quick attaches a depth/stencil buffer to every window swapchain and
+// every offscreen layer even though a 2D scene never reads it back. Dropping
+// it saves ~16 MiB per screen-sized surface and ~8 MiB per screen-sized layer
+// on a 3440x1440 monitor, plus a fixed slice on each of the hundreds of small
+// layers the shell keeps (icon tints, pill shadows), with no visual change.
+//@ pragma Env QSG_NO_DEPTH_BUFFER=1
 
 import QtQuick
 import Quickshell
