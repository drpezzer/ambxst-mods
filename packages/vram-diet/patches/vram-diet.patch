     // --- Visuals ---
+    //
+    // The frame is drawn as four edge strips plus four concave corner fillers
+    // straight into the scene. The masked variant below (a screen-sized fill
+    // rendered offscreen, with the inner rounded rectangle punched out by a
+    // second screen-sized mask texture) costs two full-screen FBOs per monitor
+    // and is only needed when the background style paints a multi-stop
+    // gradient or halftone pattern that has to run continuously around the
+    // whole frame. Neither allocates anything while the frame is disabled.
 
-    StyledRect {
-        id: frameFill
+    readonly property var bgVariantConfig: Styling.getStyledRectConfig("bg") || {}
+    readonly property bool bgNeedsWholeFrameShader: {
+        const type = bgVariantConfig.gradientType;
+        if (type === "halftone")
+            return true;
+        const stops = bgVariantConfig.gradient;
+        return (type === "linear" || type === "radial") && !!stops && stops.length >= 2;
+    }
+
+    Loader {
         anchors.fill: parent
+        active: root.frameEnabled
+        sourceComponent: root.bgNeedsWholeFrameShader ? maskedFrame : stripFrame
+    }
+
+    component FrameStrip: StyledRect {
         variant: "bg"
         radius: 0
         enableBorder: false
-        visible: root.frameEnabled
-        layer.enabled: true
-        layer.effect: MultiEffect {
-            maskEnabled: true
-            maskSource: frameMask
-            maskInverted: true
-            maskThresholdMin: 0.5
-            maskSpreadAtMin: 1.0
+        animateRadius: false
+        visible: width > 0 && height > 0
+    }
+
+    component FrameCorner: RoundCorner {
+        size: Math.round(root.innerRadius)
+        visible: size > 0
+    }
+
+    Component {
+        id: stripFrame
+
+        Item {
+            FrameStrip {
+                id: topStrip
+                x: 0
+                y: 0
+                width: root.width
+                height: root.topThickness
+            }
+
+            FrameStrip {
+                x: 0
+                y: root.height - root.bottomThickness
+                width: root.width
+                height: root.bottomThickness
+            }
+
+            FrameStrip {
+                x: 0
+                y: root.topThickness
+                width: root.leftThickness
+                height: root.height - root.topThickness - root.bottomThickness
+            }
+
+            FrameStrip {
+                x: root.width - root.rightThickness
+                y: root.topThickness
+                width: root.rightThickness
+                height: root.height - root.topThickness - root.bottomThickness
+            }
+
+            FrameCorner {
+                x: root.leftThickness
+                y: root.topThickness
+                corner: RoundCorner.CornerEnum.TopLeft
+                color: topStrip.color
+            }
+
+            FrameCorner {
+                x: root.width - root.rightThickness - width
+                y: root.topThickness
+                corner: RoundCorner.CornerEnum.TopRight
+                color: topStrip.color
+            }
+
+            FrameCorner {
+                x: root.leftThickness
+                y: root.height - root.bottomThickness - height
+                corner: RoundCorner.CornerEnum.BottomLeft
+                color: topStrip.color
+            }
+
+            FrameCorner {
+                x: root.width - root.rightThickness - width
+                y: root.height - root.bottomThickness - height
+                corner: RoundCorner.CornerEnum.BottomRight
+                color: topStrip.color
+            }
         }
     }
 
-    Item {
-        id: frameMask
-        anchors.fill: parent
-        visible: false
-        layer.enabled: true
-
-        Rectangle {
-            id: maskRect
-            x: root.leftThickness
-            y: root.topThickness
-            width: parent.width - (root.leftThickness + root.rightThickness)
-            height: parent.height - (root.topThickness + root.bottomThickness)
-            radius: root.innerRadius
-            color: "white"
-            visible: width > 0 && height > 0
+    Component {
+        id: maskedFrame
+
+        Item {
+            StyledRect {
+                id: frameFill
+                anchors.fill: parent
+                variant: "bg"
+                radius: 0
+                enableBorder: false
+                layer.enabled: true
+                layer.effect: MultiEffect {
+                    maskEnabled: true
+                    maskSource: frameMask
+                    maskInverted: true
+                    maskThresholdMin: 0.5
+                    maskSpreadAtMin: 1.0
+                }
+            }
+
+            Item {
+                id: frameMask
+                anchors.fill: parent
+                visible: false
+                layer.enabled: true
+
+                Rectangle {
+                    id: maskRect
+                    x: root.leftThickness
+                    y: root.topThickness
+                    width: parent.width - (root.leftThickness + root.rightThickness)
+                    height: parent.height - (root.topThickness + root.bottomThickness)
+                    radius: root.innerRadius
+                    color: "white"
+                    visible: width > 0 && height > 0
+                }
+            }
         }
