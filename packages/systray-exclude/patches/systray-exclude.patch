@@ -25,6 +26,24 @@ import qs.modules.components
     // Orientación derivada de la barra
     property bool vertical: bar.orientation === "vertical"
 
+    // Tray items minus anything Config.bar.systrayExclude matches, so an app the
+    // shell has a native widget for doesn't also sit in the tray.
+    readonly property var trayItems: {
+        const items = SystemTray.items?.values ?? [];
+        const excluded = Config.bar?.systrayExclude ?? [];
+        if (!excluded || excluded.length === 0)
+            return items;
+
+        return items.filter(item => {
+            const id = (item?.id ?? "").toLowerCase();
+            const title = (item?.title ?? "").toLowerCase();
+            return !excluded.some(pattern => {
+                const needle = String(pattern).toLowerCase();
+                return needle.length > 0 && (id.includes(needle) || title.includes(needle));
+            });
+        });
+    }
+
