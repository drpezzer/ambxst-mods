{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "drpezzer.caelestia-lockscreen",
  "name": "Caelestia Style Lockscreen",
  "version": "1.1.3",
  "description": "Replaces the lockscreen with a port of Caelestia's: the desktop is grabbed just before locking and blurred in and out, a Hypr-Prelock style padlock animation sweeps in, and the Material-shapes password field morphs a different shape per typed character. Clock, date, avatar, a fortune quote and a now-playing line, all in Ambxst's palette, decoding into place through a katakana scramble. The clock follows Ambxst's 12/24-hour setting. Adds lockscreen.screen (which monitor the composition is drawn on) and lockscreen.lockOnStart (lock once per session as soon as the shell is ready, for passwordless autologin).",
  "license": "MIT",
  "author": "drpezzer",
  "authorUrl": "https://github.com/drpezzer",
  "homepage": "https://github.com/drpezzer/ambxst-mods",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0",
    "testedBaseCommits": [
      "6f9e93cb81767ff14c4867c349fc176d8d9e6697"
    ]
  },
  "dependencies": [],
  "conflicts": [],
  "commands": [
    "grim",
    "caelestia"
  ],
  "permissions": [
    "Authenticates through PAM (pam.d configs shipped in modules/lockscreen/cae/assets/pam.d)",
    "Captures every output with grim into $XDG_RUNTIME_DIR/ambxst-lock just before locking; the images are deleted on unlock",
    "Reads ~/.face.icon for the avatar and runs fortune for the quote if installed",
    "Requires the caelestia-shell package for its M3Shapes and Caelestia QML plugins; it is never launched. Its caelestia-cli dependency provides the `caelestia` command the build checks for."
  ],
