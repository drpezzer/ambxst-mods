@@ -46,6 +59,58 @@ StyledRect {
         }
     }
 
+    Loader {
+        anchors.centerIn: parent
+        anchors.verticalCenterOffset: root.badgeText ? -6 : 0
+        active: root.iconSource !== ""
+
+        sourceComponent: Item {
+            implicitWidth: 20
+            implicitHeight: 20
+
+            Image {
+                id: vectorIcon
+
+                anchors.fill: parent
+                source: root.iconSource
+                // Rasterise at device resolution rather than scaling a 20px
+                // bitmap up on a HiDPI output.
+                sourceSize.width: 64
+                sourceSize.height: 64
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+                visible: false
+            }
+
+            MultiEffect {
+                anchors.fill: parent
+                source: vectorIcon
+                colorization: 1
+                colorizationColor: root.item
+
+                Behavior on colorizationColor {
+                    enabled: Config.animDuration > 0
+                    ColorAnimation {
+                        duration: Config.animDuration / 2
+                        easing.type: Easing.OutQuart
+                    }
+                }
+            }
+        }
+    }
+
+    Text {
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.bottom: parent.bottom
+        anchors.bottomMargin: 6
+        visible: root.badgeText !== ""
+        text: root.badgeText
+        color: root.item
+        font.family: Config.theme.font
+        font.pixelSize: 12
+        font.bold: true
+    }
+
     MouseArea {
         id: mouseArea
         anchors.fill: parent
