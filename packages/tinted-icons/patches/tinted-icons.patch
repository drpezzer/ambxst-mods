     property bool fullTint: false  // If true, apply solid primary color instead of shader
+    // True monochrome: colourise the icon in one flat hue while keeping its own
+    // shading (MultiEffect colorization at the icon's own brightness). Unlike
+    // fullTint it does not flatten the icon to a silhouette first, which is why
+    // fullTint stays untouched for the launcher logo: a dark logo colourised at
+    // its own brightness reads as black.
+    property bool monochrome: false
+    // Ramp tint (True Matugen Icons): the stock palette blend is replaced by a
+    // lightness ramp through the primary family, so every icon lands in one hue
+    // with its shading intact. monochrome takes precedence when both are set.
+    property bool ramp: false
+    property color tintColor: Styling.srItem("overprimary")
+    // Ramp tint only: 1.0 keeps neutral source pixels neutral (greys stay grey
+    // at the new lightness), 0.0 gives every pixel the ramp's full hue. The
+    // tray sets 0.0 because its symbolic white glyphs would otherwise stay white.
+    property real neutralKeep: 1.0
 
     // Subset of colors for optimization (consistent with TintedWallpaper.qml)
     readonly property var optimizedPalette: [
@@ -23,18 +38,27 @@ Item {
