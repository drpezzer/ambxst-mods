+    // the primary family so every icon lands in one hue with its shading
+    // intact. Feeding the whole palette to a lightness-driven blend averages
+    // competing accents into beige: matugen's accents share a lightness band.
+    readonly property var rampPalette: [
+        "background", "primaryContainer", "inversePrimary", "primary", "primaryFixed"
+    ]
+    readonly property var activePalette: root.ramp ? root.rampPalette : root.optimizedPalette
+
