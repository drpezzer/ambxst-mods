diff --git a/modules/components/Tinted.qml b/modules/components/Tinted.qml
index 7144741f..a52f22c1 100644
--- a/modules/components/Tinted.qml
+++ b/modules/components/Tinted.qml
@@ -8,6 +8,12 @@ Item {
     id: root
     property var sourceItem: null  // The icon item to tint
     property bool fullTint: false  // If true, apply solid primary color instead of shader
+    // Monochrome tint: colourise the icon in a single hue while keeping its own
+    // shading, so glyph detail survives. Unlike fullTint it does not flatten the
+    // icon to a silhouette first, which is why fullTint stays untouched for the
+    // launcher logo: a dark logo colourised at its own brightness reads as black.
+    property bool monochrome: false
+    property color tintColor: Styling.srItem("overprimary")
 
     // Subset of colors for optimization (consistent with TintedWallpaper.qml)
     readonly property var optimizedPalette: [
@@ -84,19 +90,20 @@ Item {
                 function onVisibleChanged() { if (root.visible) internalSource.scheduleUpdate(); }
             }
 
-            // Full tint fallback (solid color)
+            // Full tint fallback (solid color), or monochrome tint keeping the
+            // icon's own brightness
             MultiEffect {
-                visible: root.fullTint
+                visible: root.fullTint || root.monochrome
                 anchors.fill: parent
                 source: internalSource
-                brightness: 1.0
+                brightness: root.fullTint ? 1.0 : 0.0
                 colorization: 1.0
-                colorizationColor: Styling.srItem("overprimary")
+                colorizationColor: root.tintColor
             }
 
             // Shader-based tint
             ShaderEffect {
-                visible: !root.fullTint
+                visible: !root.fullTint && !root.monochrome
                 anchors.fill: parent
                 
                 property var source: internalSource
