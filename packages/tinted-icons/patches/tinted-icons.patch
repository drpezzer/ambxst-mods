diff --git a/modules/components/Tinted.qml b/modules/components/Tinted.qml
index 7144741f..1d7d510f 100644
--- a/modules/components/Tinted.qml
+++ b/modules/components/Tinted.qml
@@ -8,19 +8,21 @@ Item {
     id: root
     property var sourceItem: null  // The icon item to tint
     property bool fullTint: false  // If true, apply solid primary color instead of shader
+    // True monochrome: colourise the icon in one flat hue while keeping its own
+    // shading (MultiEffect colorization at the icon's own brightness). Unlike
+    // fullTint it does not flatten the icon to a silhouette first, which is why
+    // fullTint stays untouched for the launcher logo: a dark logo colourised at
+    // its own brightness reads as black.
+    property bool monochrome: false
+    property color tintColor: Styling.srItem("overprimary")
 
-    // Subset of colors for optimization (consistent with TintedWallpaper.qml)
+    // Lightness ramp the icon is rethemed through, dark to light, all from the
+    // primary family so every icon lands in one hue with its shading intact.
+    // Feeding the whole palette here averages competing accents into beige:
+    // matugen's accents share a lightness band, so a lightness-driven blend
+    // cancels their hues out.
     readonly property var optimizedPalette: [
-        "background", "overBackground", "shadow",
-        "surface", "surfaceBright", "surfaceDim",
-        "surfaceContainer", "surfaceContainerHigh", "surfaceContainerHighest", "surfaceContainerLow", "surfaceContainerLowest",
-        "primary", "secondary", "tertiary",
-        "red", "lightRed",
-        "green", "lightGreen",
-        "blue", "lightBlue",
-        "yellow", "lightYellow",
-        "cyan", "lightCyan",
-        "magenta", "lightMagenta"
+        "background", "primaryContainer", "inversePrimary", "primary", "primaryFixed"
     ]
 
     // Palette generation for the shader
@@ -84,19 +86,20 @@ Item {
                 function onVisibleChanged() { if (root.visible) internalSource.scheduleUpdate(); }
             }
 
-            // Full tint fallback (solid color)
+            // Full tint fallback (solid color), or true monochrome keeping the
+            // icon's own brightness
             MultiEffect {
-                visible: root.fullTint
+                visible: root.fullTint || root.monochrome
                 anchors.fill: parent
                 source: internalSource
-                brightness: 1.0
+                brightness: root.fullTint ? 1.0 : 0.0
                 colorization: 1.0
-                colorizationColor: Styling.srItem("overprimary")
+                colorizationColor: root.tintColor
             }
 
-            // Shader-based tint
+            // Shader-based tint: lightness ramp through the primary family
             ShaderEffect {
-                visible: !root.fullTint
+                visible: !root.fullTint && !root.monochrome
                 anchors.fill: parent
                 
                 property var source: internalSource
@@ -106,7 +109,7 @@ Item {
                 property real texHeight: root.height
 
                 vertexShader: "../widgets/dashboard/wallpapers/palette.vert.qsb"
-                fragmentShader: "../widgets/dashboard/wallpapers/palette.frag.qsb"
+                fragmentShader: "icon_ramp_tint.frag.qsb"
             }
         }
     }
