diff --git a/modules/widgets/dashboard/wallpapers/VideoWallpaper.qml b/modules/widgets/dashboard/wallpapers/VideoWallpaper.qml
index 30c36e6f..6ffb9f46 100644
--- a/modules/widgets/dashboard/wallpapers/VideoWallpaper.qml
+++ b/modules/widgets/dashboard/wallpapers/VideoWallpaper.qml
@@ -39,12 +39,20 @@ Item {
         player.stop();
         player.source = "file://" + sourceFile;
         syncDebounce.restart();
+        // video-wallpaper-optimizer: skwd plays this one; leave the player empty.
+        if (vwoHandOff())
+            return;
         updatePlayback();
     }
 
     function updatePlayback() {
         if (!sourceFile)
             return;
+        // video-wallpaper-optimizer: pausing is skwd's, not the player's.
+        if (vwoOffloaded) {
+            VideoWallpaperOptimizer.reportPause(screenName, shouldPausePlayback);
+            return;
+        }
         if (shouldPausePlayback) {
             if (player.playbackState === MediaPlayer.PlayingState)
                 player.pause();
@@ -127,9 +135,39 @@ Item {
         function onVideoSyncTickChanged() {
             if (videoWallpaper.shouldPausePlayback)
                 return;
+            // video-wallpaper-optimizer: nothing to realign, skwd plays it.
+            if (videoWallpaper.vwoOffloaded)
+                return;
             player.seek(0);
             if (player.playbackState !== MediaPlayer.PlayingState)
                 player.play();
         }
     }
+
+    // ── video-wallpaper-optimizer ─────────────────────────────────────
+    // skwd-wall renders this video (VideoWallpaperOptimizer) instead of the
+    // QtMultimedia player above. A tinted wallpaper stays here: the tint is a
+    // shader on this item that skwd cannot apply.
+    readonly property bool vwoOffloaded: !tint && VideoWallpaperOptimizer.offloads(sourceFile)
+    // Handed over, or handed back (skwd stopped or failed): start over.
+    onVwoOffloadedChanged: restartPlayback()
+
+    function vwoHandOff() {
+        if (!vwoOffloaded)
+            return false;
+        player.stop();
+        player.source = "";
+        VideoWallpaperOptimizer.reportPause(screenName, shouldPausePlayback);
+        // Renderers that wait for the first decoded frame (transitions, the
+        // entrance curtain) count a handed-off video as shown.
+        if ("hasFirstFrame" in videoWallpaper && !videoWallpaper.hasFirstFrame) {
+            videoWallpaper.hasFirstFrame = true;
+            videoWallpaper.firstFrameReady();
+        }
+        return true;
+    }
+
+    QtObject {
+        Component.onDestruction: VideoWallpaperOptimizer.reportPause(videoWallpaper.screenName, false)
+    }
 }
